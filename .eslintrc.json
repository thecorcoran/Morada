{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest/globals": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "jest"
  ],
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-useless-escape": "off"
  },
  "globals": {
    "tinymce": "readonly",
    "Sortable": "readonly",
    "AppConstants": "writable",
    "MyProjectStateManager": "writable",
    "MyProjectCanvasRenderer": "writable",
    "MyProjectNodeManager": "writable",
    "MyProjectEditorManager": "writable",
    "MyProjectUIManager": "writable",
    "MyProjectDataStorage": "writable",
    "StrunkEngine": "writable"
  },
  "ignorePatterns": [
    "node_modules/",
    "assets/",
    "dist/"
  ]
}
