{
  "name": "morada-project",
  "version": "1.0.0-beta.1",
  "description": "A fractal writing environment.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "test": "jest",
    "lint": "eslint .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "Morada Authors",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "jest": "^29.7.0",
    "ncp": "^2.0.0",
    "tinymce": "^7.1.2"
  },
  "dependencies": {
    "sortablejs": "^1.15.6"
  },
  "build": {
    "appId": "com.morada.app",
    "productName": "Morada",
    "copyright": "Copyright © 2026",
    "icon": "assets/icon.png",
    "publish": {
      "provider": "github",
      "owner": "thecorcoran",
      "repo": "Morada"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.test.js",
      "!tests/**",
      "!docs/**",
      "!.*",
      "!dist/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
