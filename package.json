{
  "name": "morada-project",
  "version": "1.0.0-beta.1",
  "description": "A fractal writing environment.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "test": "jest",
    "lint": "eslint .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "Morada Authors",
  "license": "ISC",
  "homepage": "https://thecorcoran.github.io/Morada/",
  "repository": {
    "type": "git",
    "url": "https://github.com/thecorcoran/Morada.git"
  },
  "bugs": {
    "url": "https://github.com/thecorcoran/Morada/issues"
  },
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/vollkorn": "^5.3.0",
    "docx": "^9.8.1",
    "sortablejs": "^1.15.6",
    "tinymce": "^7.1.2"
  },
  "build": {
    "appId": "com.morada.app",
    "productName": "Morada",
    "copyright": "Copyright © 2026",
    "icon": "assets/icon.png",
    "publish": {
      "provider": "github",
      "owner": "thecorcoran",
      "repo": "Morada",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.test.js",
      "!tests/**",
      "!docs/**",
      "!.*",
      "!dist/**",
      "!scratch/**",
      "!scripts/**",
      "!morada-data.json*",
      "!eslintrc.json",
      "!*.md",
      "!js/README.md"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Morada-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Morada-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Morada-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Morada Authors <thecorcoran@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "Morada-${version}.${ext}"
    },
    "deb": {
      "artifactName": "morada_${version}_${arch}.${ext}"
    }
  }
}
